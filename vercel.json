{
  "crons": [
    { "path": "/api/cron/send-followups", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/api/agent-response", "destination": "/api/agent/response" },
    { "source": "/api/agent-run", "destination": "/api/agent/run" },
    { "source": "/api/confirm-email", "destination": "/api/email/confirm" },
    { "source": "/api/unsubscribe", "destination": "/api/email/unsubscribe" },
    {
      "source": "/((?!api/|assets/|favicon.svg|icons.svg|widget\\.js|widget\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/((?!api/|widget\\.html|widget\\.js).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=()" },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
