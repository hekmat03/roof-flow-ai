
# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel → Project Settings → Environment Variables. NEVER commit real keys.
XAI_API_KEY=
# Optional (defaults to grok-4.3)
AI_MODEL=grok-4.3
# Optional: use GroqCloud instead (free tier). Set AI_PROVIDER=groq and GROQ_API_KEY.
AI_PROVIDER=
GROQ_API_KEY=

# --- Phase 2 (all optional; features degrade to demo mode without them) ---
# Supabase → Project Settings → API. Use the SERVICE ROLE key (server only!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Email is optional. Without both the API key and a verified sender, actions are
# recorded only. Phone delivery remains unavailable.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=RoofFlow <hello@yourdomain.com>
# Protects the scheduled worker endpoint; set the same random value in Vercel.
CRON_SECRET=
# Used to build absolute unsubscribe links.
APP_BASE_URL=https://YOUR-DOMAIN
# Also signs unsubscribe tokens (Google OAuth state uses this existing secret).
SESSION_SECRET=

# --- Browser (Vite) Supabase: ANON key only, protected by RLS ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Google Calendar (server only; set in Vercel env vars) ---
# Google Cloud Console -> APIs & Services: enable "Google Calendar API", create an
# OAuth client (Web application) and add this redirect URI:
#   https://YOUR-DOMAIN/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/google/callback
# Long random string (e.g. `openssl rand -hex 32`). Signs OAuth state and unsubscribe links.
# Optional separate key for encrypting stored Google tokens (falls back to SESSION_SECRET)
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- User management (server only) ---
# Run supabase/014_user_management.sql once. Comma-separated emails of the platform
# operators who get the "Admin panel — all users" section on the Team & Users tab.
ADMIN_EMAILS=

# --- Sign-in options (browser build) ---
# Set to true ONLY after enabling the Google provider in Supabase -> Authentication -> Providers.
VITE_ENABLE_GOOGLE_LOGIN=false

# --- Setup check (optional) ---
# 12+ random characters. Lets `node scripts/verify-env.mjs --site https://YOUR-DOMAIN --token THIS_VALUE`
# read the detailed variable check from /api/team/health. Without it that page only answers {"ok": true/false}.
HEALTH_TOKEN=

# --- Lead form bot protection (Cloudflare Turnstile, free) ---
# 1) Cloudflare dashboard -> Turnstile -> add a widget for your domain.
# 2) Put the SECRET key here (server only). When set, every widget lead must pass the check.
# 3) Put the public SITE key in the embed: <script ... data-key="wk_..." data-ts="SITE_KEY">
# Leave empty to skip the check (per-key limits and duplicate blocking still apply).
TURNSTILE_SECRET_KEY=
