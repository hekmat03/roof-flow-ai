# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel → Project Settings → Environment Variables. NEVER commit real keys.
MISTRAL_API_KEY=
# Optional (defaults to mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# --- Phase 2 (all optional; features degrade to demo mode without them) ---
# Supabase → Project Settings → API. Use the SERVICE ROLE key (server only!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NOTE: no email/SMS provider is configured. RoofFlow AI records outreach
# intents but never delivers messages, so there is no RESEND_* / Twilio config.
