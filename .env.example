
# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel → Project Settings → Environment Variables. NEVER commit real keys.
MISTRAL_API_KEY=
# Optional (defaults to mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# --- Phase 2 (all optional; features degrade to demo mode without them) ---
# Supabase → Project Settings → API. Use the SERVICE ROLE key (server only!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Email is optional. Without both the API key and a verified sender, actions are
# recorded only. SMS and phone delivery remain unavailable.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=RoofFlow <hello@yourdomain.com>
# Protects the scheduled worker endpoint; set the same random value in Vercel.
CRON_SECRET=
# Used to build absolute unsubscribe links.
APP_BASE_URL=https://YOUR-DOMAIN
# Also signs unsubscribe tokens (Google OAuth state uses this existing secret).
SESSION_SECRET=

# --- Browser (Vite) Supabase: ANON key only, protected by RLS ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Step 3: Lemon Squeezy billing (server only; set in Vercel env vars) ---
# Lemon Squeezy -> Settings -> Webhooks: URL https://YOUR-DOMAIN/api/lemon-webhook
LS_WEBHOOK_SECRET=
# Variant ids of your two subscription products (Starter $19, Pro $39)
LS_VARIANT_STARTER=
LS_VARIANT_PRO=
# Hosted checkout "buy" links (Product -> Share). In each product set the
# confirmation redirect to https://YOUR-DOMAIN/app?billing=success
LS_CHECKOUT_URL_STARTER=
LS_CHECKOUT_URL_PRO=
# Optional but recommended: lets "Manage billing" open a fresh portal link
LS_API_KEY=

# --- Google Calendar (server only; set in Vercel env vars) ---
# Google Cloud Console -> APIs & Services: enable "Google Calendar API", create an
# OAuth client (Web application) and add this redirect URI:
#   https://YOUR-DOMAIN/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/api/google/callback
# Long random string (e.g. `openssl rand -hex 32`). Signs OAuth state and unsubscribe links.
# Optional separate key for encrypting stored Google tokens (falls back to SESSION_SECRET)
GOOGLE_TOKEN_ENCRYPTION_KEY=
