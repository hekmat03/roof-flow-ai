
# Copy to .env.local for `vercel dev`, and set the same names in
# Vercel → Project Settings → Environment Variables. NEVER commit real keys.
MISTRAL_API_KEY=
# Optional (defaults to mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# --- Phase 2 (all optional; features degrade to demo mode without them) ---
# Supabase → Project Settings → API. Use the SERVICE ROLE key (server only!).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# NOTE: no email/SMS provider is configured. RoofFlow AI records outreach
# intents but never delivers messages, so there is no RESEND_* / Twilio config.

# --- Browser (Vite) Supabase: ANON key only, protected by RLS ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Step 3: Lemon Squeezy billing (server only; set in Vercel env vars) ---
# Lemon Squeezy -> Settings -> Webhooks: URL https://YOUR-DOMAIN/api/lemon-webhook
LS_WEBHOOK_SECRET=
# Variant ids of your two subscription products (Starter $19, Pro $39)
LS_VARIANT_STARTER=
LS_VARIANT_PRO=
# Hosted checkout "buy" links (Product -> Share). In each product set the
# confirmation redirect to https://YOUR-DOMAIN/app?billing=success
LS_CHECKOUT_URL_STARTER=
LS_CHECKOUT_URL_PRO=
# Optional but recommended: lets "Manage billing" open a fresh portal link
LS_API_KEY=
